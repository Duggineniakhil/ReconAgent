# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reconagent

# Server
PORT=3000
NODE_ENV=development
# Folder with ledger_records.csv, bank_transactions.csv, ground_truth.json (default: ./data)
# DATA_DIR=data

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash
# Requests per minute across the server (free tier: 15; 0 = unlimited)
GEMINI_RPM=15
# Records reconciled in parallel during a run
RUN_CONCURRENCY=2

# Integration tests: a disposable database — every table in it is truncated
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reconagent_test
